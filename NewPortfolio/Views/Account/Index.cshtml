@model IEnumerable<NewPortfolio.Entities.ApplicationUser>
@using System.Linq

<h2>Registered Accounts</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Email</th>
            <th>Full Name</th>
            <th>Created Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model ?? Enumerable.Empty<NewPortfolio.Entities.ApplicationUser>())
        {
            <tr>
                <td>@user.Email</td>
                <td>@(string.IsNullOrEmpty(user.FullName) ? "N/A" : user.FullName)</td>
                <td>@(user.CreatedDate?.ToString("MM/dd/yyyy HH:mm:ss") ?? "N/A")</td>
                <td>
                    <a asp-controller="Role" asp-action="AssignRole" asp-route-id="@user.Id" class="btn btn-sm btn-info">Assign Role</a>
                    <a asp-action="AssignPermissions" asp-route-id="@user.Id" class="btn btn-sm btn-info">Assign Permissions</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model?.Any() ?? true)
{
    <p>No registered accounts found.</p>
}

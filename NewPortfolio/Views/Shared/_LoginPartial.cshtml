@using Microsoft.AspNetCore.Identity
@using NewPortfolio.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <form asp-action="Logout" asp-controller="Account" method="post" style="display:inline">
            <button class="nav-link btn btn-link text-dark" type="submit">Logout</button>
        </form>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-action="Login" asp-controller="Account">Login</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-action="Register" asp-controller="Account">Register</a>
        </li>
    }
</ul>


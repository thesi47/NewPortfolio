@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>
@using System.Linq

<h2>Roles</h2>
<p>
    <a asp-action="Create" class="btn btn-primary">Create New Role</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var role in Model ?? Enumerable.Empty<Microsoft.AspNetCore.Identity.IdentityRole>())
{
        <tr>
            <td>@role.Name</td>
            <td>
                <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-secondary">Edit</a>
                <a asp-action="Delete" asp-route-id="@role.Id" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

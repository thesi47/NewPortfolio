@model NewPortfolio.Models.EducationViewModel

<h1>Create Personal Info</h1>

<form asp-action="Create" method="post">

    <div>
        <label>Subject</label>
        <input asp-for="Subject" />
    </div>

    <div>
        <label>Passing Year</label>
        <input asp-for="PassingYear" />
    </div>

    <div>
        <label>Institute Name</label>
        <input asp-for="InstituteName" />
    </div>

    <input type="submit" value="Create" />

</form>
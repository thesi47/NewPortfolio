@model NewPortfolio.Entities.Skill

<h1>Edit Skill Info</h1>

<form asp-action="Edit" method="post">

    <input asp-for="Id" type="hidden" />

    <div>
        <label>Name</label>
        <input asp-for="Name" />
    </div>

    <div>
        <label>Level</label>
        <input asp-for="Level" />
    </div>

    <div>
        <label>Duration</label>
        <input asp-for="Duration" />
    </div>

    <input type="submit" value="Save" />

</form>
@model IEnumerable<NewPortfolio.Entities.Skill>

<h1>Skill Info</h1>

<a asp-action="Create">Create</a>

<table>

    <thead>
        <tr>
            <th>Name</th>
            <th>Level</th>
            <th>Duration</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Name</td>
                <td>@item.Level</td>
                <td>@item.Duration</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>

            </tr>
        }

    </tbody>

</table>
@model IEnumerable<NewPortfolio.Entities.PersonalInfo>


<h1> Personal Info </h1>
<table>
    <thead>
        <tr>
        <th>Name</th>
        <th>Phone</th>
        <th>Address</th>
        <th>Email</th>
        <th>Actions</th></tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>            
                <td>@item.Name</td>
                <td>@item.Phone</td>
                <td>@item.Address</td>
                <td>@item.Email</td>
                <td>
                    <a asp-action="Edit">Edit</a>
                    <a asp-action="Delete">Delete</a>
                </td>
</tr>
        }

</tbody>
</table>
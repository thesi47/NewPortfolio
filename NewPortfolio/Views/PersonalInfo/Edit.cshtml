@model NewPortfolio.Entities.PersonalInfo

<h1>Edit Personal Info</h1>

<form asp-action="Edit" method="post">

    <input asp-for="Id" type="hidden" />

    <div>
        <label>Name</label>
        <input asp-for="Name" />
    </div>

    <div>
        <label>Phone</label>
        <input asp-for="Phone" />
    </div>

    <div>
        <label>Address</label>
        <input asp-for="Address" />
    </div>

    <div>
        <label>Email</label>
        <input asp-for="Email" />
    </div>

    <input type="submit" value="Save" />

</form>
@model NewPortfolio.Models.PersonalInfoViewModel

<h1>Create Personal Info</h1>

<form asp-action="Create" method="post">

    <div>
        <label>Name</label>
        <input asp-for="Name" />
    </div>

    <div>
        <label>Phone</label>
        <input asp-for="Phone" />
    </div>

    <div>
        <label>Address</label>
        <input asp-for="Address" />
    </div>

    <div>
        <label>Email</label>
        <input asp-for="Email" />
    </div>

    <input type="submit" value="Create" />

</form>